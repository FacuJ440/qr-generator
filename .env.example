# ---------- Production Environment ----------
# Copy to .env and fill with real values before running: docker compose up -d --build

# Database
DB_USERNAME=postgres
DB_PASSWORD=change-this-strong-password
DB_DATABASE=qr_generator

# JWT secrets (REQUIRED — use long random strings)
JWT_SECRET=generate-a-long-random-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate-another-long-random-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# App
# The public URL where the app is accessible (no trailing slash)
BASE_DOMAIN=https://qr.yourdomain.com
CORS_ORIGIN=https://qr.yourdomain.com
